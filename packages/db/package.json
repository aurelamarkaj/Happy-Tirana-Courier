{
  "name": "@happy-tirana/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "migrate": "psql \"$DATABASE_URL\" -f migrations/001_initial_postgis.sql -f migrations/002_customer_ordering.sql -f migrations/003_customer_accounts_cart_seed.sql -f migrations/004_customer_catalog_addresses_routes.sql -f migrations/005_guest_carts.sql",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "typescript": "^5.9.0"
  }
}
