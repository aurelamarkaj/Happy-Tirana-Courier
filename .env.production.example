# Copy to .env.production and generate independent random secrets before deployment.
# Use the same URL-safe database password in both values below.
PUBLIC_URL=https://delivery.example.com
# Optional comma-separated browser origins; defaults to PUBLIC_URL.
# CORS_ORIGINS=https://delivery.example.com
DATABASE_URL=postgresql://happy:replace-with-a-long-random-password@postgres:5432/happy_tirana
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_HTTP_REFERRER=https://delivery.example.com/
RIDER_DEBIT_LIMIT_ALL=5000
NEARBY_RIDER_RADIUS_METERS=1000
OFFER_ESCALATION_SECONDS=60
PORT=4000

# Optional documentation/bootstrap values for demo accounts
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-demo-password
DEMO_BUSINESS_EMAIL=business@example.com
DEMO_BUSINESS_PASSWORD=replace-with-a-demo-password
DEMO_RIDER_EMAIL=rider@example.com
DEMO_RIDER_PASSWORD=replace-with-a-demo-password

# Maximum road distance between the two businesses and between the two destinations.
SECOND_ORDER_BUSINESS_RADIUS_METERS=500
SECOND_ORDER_DESTINATION_RADIUS_METERS=500
