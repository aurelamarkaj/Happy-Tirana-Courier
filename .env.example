DATABASE_URL=postgresql://happy:happy@localhost:5433/happy_tirana
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Browser map rendering.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-local-dev-key

# Server-side Google Directions pricing. Required for transport quotes/orders.
GOOGLE_MAPS_API_KEY=replace-with-server-directions-key
RIDER_DEBIT_LIMIT_ALL=10000
NEARBY_RIDER_RADIUS_METERS=1000
OFFER_ESCALATION_SECONDS=60
ADMIN_UNASSIGNED_ALERT_MINUTES=5
JWT_SECRET=replace-with-long-local-secret
PORT=4000

# Optional local bootstrap for `npm run db:create-admin`
ADMIN_NAME=Local Superadmin
ADMIN_EMAIL=admin@example.local
ADMIN_PHONE=+355690000000
ADMIN_PASSWORD=replace-with-local-admin-password
